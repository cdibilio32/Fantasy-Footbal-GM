# ESPN Fantasy Football Credentials
# Get these from your browser's dev tools (Application -> Cookies) after
# logging into fantasy.espn.com. Only required for private leagues.
ESPN_S2=your_espn_s2_cookie_here
ESPN_SWID={your_swid_here}

# Optional: defaults to 2025 if unset
ESPN_SEASON_YEAR=2025

# Your ESPN league(s). Add LEAGUE_2_*, LEAGUE_3_*, etc. for more leagues -
# every agent runs once per configured league unless you pass --league/--team.
LEAGUE_1_ID=your_league_id
LEAGUE_1_TEAM_ID=your_team_id_in_this_league
LEAGUE_1_NAME="My League"

# OpenRouter (the only LLM provider these agents use)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
# Any OpenRouter model id; defaults to deepseek/deepseek-v4.1-flash
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
