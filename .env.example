# See fantasy-engine/agents/.env.example — the agents load their .env from
# fantasy-engine/agents/, not from the repo root. This file only exists so a
# Claude Code / GitHub web session picks up the same variables automatically.

# ESPN Fantasy Football Credentials (from browser dev tools after logging
# into fantasy.espn.com; only required for private leagues)
ESPN_S2=your_espn_s2_cookie_here
ESPN_SWID={your_swid_here}
ESPN_SEASON_YEAR=2025

# Your ESPN league. Add LEAGUE_2_*, LEAGUE_3_*, etc. for more leagues.
LEAGUE_1_ID=your_league_id
LEAGUE_1_TEAM_ID=your_team_id_in_this_league
LEAGUE_1_NAME="My League"

# OpenRouter (the only LLM provider the agents use)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b
